<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hill Climb Advanced: Nexus Edition</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #05050a;
            color: #f3f4f6;
            overflow: hidden;
            user-select: none;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        .neon-glow {
            text-shadow: 0 0 10px rgba(0, 243, 255, 0.7), 0 0 20px rgba(0, 243, 255, 0.5);
        }
        .neon-box {
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.3), inset 0 0 15px rgba(0, 243, 255, 0.1);
            border: 1px solid rgba(0, 243, 255, 0.4);
        }
        .glass-panel {
            background: rgba(10, 10, 25, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .scanner-lines {
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 6px 100%;
        }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.8; filter: drop-shadow(0 0 8px rgba(0,243,255,0.8)); }
            50% { opacity: 1; filter: drop-shadow(0 0 20px rgba(0,243,255,1)); }
        }
        .animate-pulse-glow {
            animation: pulseGlow 2s infinite;
        }
    </style>
</head>
<body class="relative w-screen h-screen">

    <!-- Game Canvas -->
    <canvas id="gameCanvas" class="absolute inset-0 w-full h-full block z-0"></canvas>

    <!-- UI Overlay Layer -->
    <div id="uiLayer" class="absolute inset-0 pointer-events-none z-10 flex flex-col justify-between p-6 scanner-lines">
        
        <!-- Top HUD -->
        <div id="hudTop" class="flex justify-between items-start w-full opacity-0 transition-opacity duration-500">
            <!-- Left: Stats -->
            <div class="glass-panel p-4 rounded-2xl flex gap-6 items-center pointer-events-auto neon-box">
                <div>
                    <div class="text-xs text-cyan-400 font-orbitron tracking-wider">DISTANCE</div>
                    <div id="hudDistance" class="text-2xl font-black font-orbitron text-white">0 m</div>
                </div>
                <div class="h-8 w-px bg-cyan-500/30"></div>
                <div>
                    <div class="text-xs text-yellow-400 font-orbitron tracking-wider">CREDITS</div>
                    <div id="hudCoins" class="text-2xl font-black font-orbitron text-yellow-300">0 🪙</div>
                </div>
                <div class="h-8 w-px bg-cyan-500/30"></div>
                <div>
                    <div class="text-xs text-purple-400 font-orbitron tracking-wider">SPEED</div>
                    <div id="hudSpeed" class="text-2xl font-black font-orbitron text-purple-300">0 km/h</div>
                </div>
            </div>

            <!-- Right: Controls / Pause / Combo -->
            <div class="flex gap-4 items-center">
                <div id="hudCombo" class="glass-panel px-4 py-2 rounded-xl text-center hidden transform scale-110 transition-transform">
                    <div class="text-xs text-pink-400 font-orbitron" id="comboText">FLIP x2!</div>
                    <div class="text-lg font-bold text-white" id="comboBonus">+250 PTS</div>
                </div>
                <button id="pauseBtn" class="pointer-events-auto glass-panel px-5 py-3 rounded-xl font-orbitron text-cyan-400 hover:bg-cyan-500/20 transition neon-box flex items-center gap-2">
                    <i class="fa-solid fa-pause"></i> PAUSE
                </button>
            </div>
        </div>

        <!-- Center: Floating Messages / Stunt Notifications -->
        <div id="floatingHudContainer" class="absolute top-1/3 left-1/2 transform -translate-x-1/2 -translate-y-1/2 pointer-events-none text-center">
            <h1 id="stuntAlert" class="text-4xl md:text-6xl font-black font-orbitron text-cyan-300 neon-glow opacity-0 transition-all duration-300 transform scale-50"></h1>
        </div>

        <!-- Bottom HUD: Fuel & Turbo -->
        <div id="hudBottom" class="flex justify-between items-end w-full opacity-0 transition-opacity duration-500">
            <!-- Fuel Meter -->
            <div class="glass-panel p-4 rounded-2xl w-72 pointer-events-auto neon-box">
                <div class="flex justify-between text-xs font-orbitron mb-1 text-cyan-400">
                    <span>REACTOR ENERGY</span>
                    <span id="fuelText">100%</span>
                </div>
                <div class="w-full h-3 bg-gray-800 rounded-full overflow-hidden p-0.5 border border-cyan-500/30">
                    <div id="fuelBar" class="h-full bg-gradient-to-r from-cyan-500 to-blue-600 rounded-full transition-all duration-100" style="width: 100%"></div>
                </div>
            </div>

            <!-- Mobile Controls / Touch / Nitro -->
            <div class="flex gap-3 pointer-events-auto">
                <button id="nitroBtn" class="glass-panel px-6 py-4 rounded-2xl font-orbitron text-yellow-400 hover:bg-yellow-500/20 transition neon-box font-bold flex items-center gap-2">
                    <i class="fa-solid fa-bolt"></i> TURBO
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN MENU OVERLAY -->
    <div id="mainMenu" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/80 backdrop-blur-md transition-opacity duration-500">
        <div class="text-center mb-10">
            <h1 class="text-5xl md:text-7xl font-black font-orbitron text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 neon-glow mb-3">
                HILL CLIMB ADVANCED
            </h1>
            <p class="text-cyan-200/70 font-orbitron tracking-widest text-sm md:text-base">NEXUS EDITION // PROTOTYPE V2.5</p>
        </div>

        <div class="flex flex-col gap-4 w-72">
            <button onclick="startGame()" class="glass-panel py-4 rounded-xl font-orbitron font-bold text-cyan-300 hover:bg-cyan-500/30 transition neon-box flex items-center justify-center gap-3 text-lg">
                <i class="fa-solid fa-play"></i> LAUNCH GAME
            </button>
            <button onclick="openGarage()" class="glass-panel py-4 rounded-xl font-orbitron font-bold text-purple-300 hover:bg-purple-500/30 transition neon-box flex items-center justify-center gap-3 text-lg">
                <i class="fa-solid fa-car-tunnel"></i> GARAGE & UPGRADES
            </button>
            <button onclick="openLevelSelect()" class="glass-panel py-4 rounded-xl font-orbitron font-bold text-yellow-300 hover:bg-yellow-500/30 transition neon-box flex items-center justify-center gap-3 text-lg">
                <i class="fa-solid fa-globe"></i> BIOME SELECT
            </button>
        </div>

        <div class="absolute bottom-6 text-xs text-gray-500 font-orbitron">
            CONTROLS: [A/D] or [LEFT/RIGHT] Tilt/Drive | [SPACE] Nitro | [ESC] Pause
        </div>
    </div>

    <!-- GARAGE OVERLAY -->
    <div id="garageMenu" class="absolute inset-0 z-20 hidden flex-col items-center justify-center bg-black/90 backdrop-blur-lg p-6">
        <div class="max-w-4xl w-full glass-panel p-8 rounded-3xl neon-box flex flex-col h-[85vh]">
            <div class="flex justify-between items-center mb-6 border-b border-cyan-500/30 pb-4">
                <h2 class="text-3xl font-black font-orbitron text-cyan-400 neon-glow"><i class="fa-solid fa-wrench"></i> NEXUS GARAGE</h2>
                <div class="flex items-center gap-6">
                    <div class="text-xl font-orbitron text-yellow-300" id="garageCoins">0 🪙</div>
                    <button onclick="closeGarage()" class="glass-panel px-4 py-2 rounded-xl text-red-400 hover:bg-red-500/20 font-orbitron"><i class="fa-solid fa-xmark"></i> CLOSE</button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 flex-1 overflow-y-auto pr-2">
                <!-- Vehicle Showcase -->
                <div class="flex flex-col items-center justify-center glass-panel rounded-2xl p-6 relative">
                    <div class="absolute top-4 left-4 text-xs font-orbitron text-cyan-300">CURRENT CHASSIS</div>
                    <div id="carPreviewName" class="text-2xl font-black font-orbitron text-white mt-2">CYBER BUGGY V1</div>
                    <div class="w-full h-48 flex items-center justify-center my-6 relative">
                        <i class="fa-solid fa-car-side text-7xl text-cyan-400 animate-pulse-glow"></i>
                    </div>
                    <p class="text-xs text-gray-400 text-center">Balanced multi-terrain exploration vehicle equipped with quantum suspension dampers.</p>
                </div>

                <!-- Upgrades Tree -->
                <div class="flex flex-col gap-4">
                    <h3 class="text-lg font-orbitron text-cyan-300 mb-2">PERFORMANCE UPGRADES</h3>
                    
                    <!-- Upgrade Item: Engine -->
                    <div class="glass-panel p-4 rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-orbitron font-bold text-sm text-white">QUANTUM ENGINE</div>
                            <div class="text-xs text-gray-400">Boosts torque & top velocity</div>
                            <div class="text-xs text-cyan-400 font-orbitron mt-1">LEVEL <span id="lvlEngine">1</span>/10</div>
                        </div>
                        <button onclick="upgradeStat('engine')" id="btnEngine" class="glass-panel px-4 py-2 rounded-lg font-orbitron text-yellow-300 hover:bg-yellow-500/20 text-sm">
                            COST: <span id="costEngine">100</span> 🪙
                        </button>
                    </div>

                    <!-- Upgrade Item: Tires -->
                    <div class="glass-panel p-4 rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-orbitron font-bold text-sm text-white">GRIP MATRIX TIRES</div>
                            <div class="text-xs text-gray-400">Enhances surface traction & slope climbing</div>
                            <div class="text-xs text-cyan-400 font-orbitron mt-1">LEVEL <span id="lvlTires">1</span>/10</div>
                        </div>
                        <button onclick="upgradeStat('tires')" id="btnTires" class="glass-panel px-4 py-2 rounded-lg font-orbitron text-yellow-300 hover:bg-yellow-500/20 text-sm">
                            COST: <span id="costTires">100</span> 🪙
                        </button>
                    </div>

                    <!-- Upgrade Item: Suspension -->
                    <div class="glass-panel p-4 rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-orbitron font-bold text-sm text-white">HYDRAULIC SUSPENSION</div>
                            <div class="text-xs text-gray-400">Absorbs shock & stabilizes landings</div>
                            <div class="text-xs text-cyan-400 font-orbitron mt-1">LEVEL <span id="lvlSuspension">1</span>/10</div>
                        </div>
                        <button onclick="upgradeStat('suspension')" id="btnSuspension" class="glass-panel px-4 py-2 rounded-lg font-orbitron text-yellow-300 hover:bg-yellow-500/20 text-sm">
                            COST: <span id="costSuspension">100</span> 🪙
                        </button>
                    </div>

                    <!-- Upgrade Item: Turbo -->
                    <div class="glass-panel p-4 rounded-xl flex items-center justify-between">
                        <div>
                            <div class="font-orbitron font-bold text-sm text-white">NITRO INJECTOR</div>
                            <div class="text-xs text-gray-400">Increases nitro burst duration</div>
                            <div class="text-xs text-cyan-400 font-orbitron mt-1">LEVEL <span id="lvlTurbo">1</span>/10</div>
                        </div>
                        <button onclick="upgradeStat('turbo')" id="btnTurbo" class="glass-panel px-4 py-2 rounded-lg font-orbitron text-yellow-300 hover:bg-yellow-500/20 text-sm">
                            COST: <span id="costTurbo">150</span> 🪙
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LEVEL SELECT OVERLAY -->
    <div id="levelMenu" class="absolute inset-0 z-20 hidden flex-col items-center justify-center bg-black/90 backdrop-blur-lg p-6">
        <div class="max-w-3xl w-full glass-panel p-8 rounded-3xl neon-box">
            <div class="flex justify-between items-center mb-6 border-b border-cyan-500/30 pb-4">
                <h2 class="text-3xl font-black font-orbitron text-cyan-400 neon-glow"><i class="fa-solid fa-globe"></i> SELECT BIOME</h2>
                <button onclick="closeLevelSelect()" class="glass-panel px-4 py-2 rounded-xl text-red-400 hover:bg-red-500/20 font-orbitron"><i class="fa-solid fa-xmark"></i> CLOSE</button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Biome 1 -->
                <div onclick="selectBiome(0)" class="glass-panel p-6 rounded-2xl cursor-pointer hover:border-cyan-400 transition group border border-cyan-500/20">
                    <div class="text-cyan-400 font-orbitron text-sm mb-1">BIOME 01</div>
                    <div class="text-xl font-bold font-orbitron text-white group-hover:text-cyan-300">NEON CYBERCITY</div>
                    <p class="text-xs text-gray-400 mt-2">Sleek futuristic highways with balanced friction and moderate rolling hills.</p>
                </div>
                <!-- Biome 2 -->
                <div onclick="selectBiome(1)" class="glass-panel p-6 rounded-2xl cursor-pointer hover:border-purple-400 transition group border border-purple-500/20">
                    <div class="text-purple-400 font-orbitron text-sm mb-1">BIOME 02</div>
                    <div class="text-xl font-bold font-orbitron text-white group-hover:text-purple-300">CRYSTALLINE CAVERNS</div>
                    <p class="text-xs text-gray-400 mt-2">Treacherous crystal slopes with slippery icy patches and steep inclines.</p>
                </div>
                <!-- Biome 3 -->
                <div onclick="selectBiome(2)" class="glass-panel p-6 rounded-2xl cursor-pointer hover:border-red-400 transition group border border-red-500/20">
                    <div class="text-red-400 font-orbitron text-sm mb-1">BIOME 03</div>
                    <div class="text-xl font-bold font-orbitron text-white group-hover:text-red-300">VOLCANIC RIDGE</div>
                    <p class="text-xs text-gray-400 mt-2">Extreme jagged peaks, lava pits, and high stunt multipliers.</p>
                </div>
                <!-- Biome 4 -->
                <div onclick="selectBiome(3)" class="glass-panel p-6 rounded-2xl cursor-pointer hover:border-blue-400 transition group border border-blue-500/20">
                    <div class="text-blue-400 font-orbitron text-sm mb-1">BIOME 04</div>
                    <div class="text-xl font-bold font-orbitron text-white group-hover:text-blue-300">STRATOSPHERE PEAKS</div>
                    <p class="text-xs text-gray-400 mt-2">Massive gravity-defying jumps above the cloud layer.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- PAUSE MENU OVERLAY -->
    <div id="pauseMenu" class="absolute inset-0 z-30 hidden flex flex-col items-center justify-center bg-black/80 backdrop-blur-md">
        <div class="glass-panel p-8 rounded-3xl neon-box w-80 text-center">
            <h2 class="text-3xl font-black font-orbitron text-cyan-400 neon-glow mb-6">GAME PAUSED</h2>
            <div class="flex flex-col gap-4">
                <button onclick="resumeGame()" class="glass-panel py-3 rounded-xl font-orbitron font-bold text-cyan-300 hover:bg-cyan-500/30 transition">RESUME</button>
                <button onclick="openGarageFromPause()" class="glass-panel py-3 rounded-xl font-orbitron font-bold text-purple-300 hover:bg-purple-500/30 transition">GARAGE</button>
                <button onclick="returnToMainMenu()" class="glass-panel py-3 rounded-xl font-orbitron font-bold text-red-300 hover:bg-red-500/30 transition">MAIN MENU</button>
            </div>
        </div>
    </div>

    <!-- GAME OVER / VICTORY OVERLAY -->
    <div id="gameOverMenu" class="absolute inset-0 z-30 hidden flex flex-col items-center justify-center bg-black/85 backdrop-blur-md">
        <div class="glass-panel p-8 rounded-3xl neon-box w-96 text-center">
            <h2 id="gameOverTitle" class="text-4xl font-black font-orbitron text-red-500 neon-glow mb-2">RUN TERMINATED</h2>
            <p id="gameOverReason" class="text-xs text-gray-400 font-orbitron mb-6">Reactor Core Depleted / Chassis Rolled</p>
            
            <div class="flex flex-col gap-3 mb-6 bg-black/40 p-4 rounded-xl border border-white/5">
                <div class="flex justify-between text-sm font-orbitron">
                    <span class="text-gray-400">DISTANCE:</span>
                    <span id="endDistance" class="text-white font-bold">0 m</span>
                </div>
                <div class="flex justify-between text-sm font-orbitron">
                    <span class="text-gray-400">COINS EARNED:</span>
                    <span id="endCoins" class="text-yellow-300 font-bold">+0 🪙</span>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <button onclick="restartGame()" class="glass-panel py-3 rounded-xl font-orbitron font-bold text-cyan-300 hover:bg-cyan-500/30 transition">TRY AGAIN</button>
                <button onclick="returnToMainMenu()" class="glass-panel py-3 rounded-xl font-orbitron font-bold text-gray-300 hover:bg-gray-500/30 transition">MAIN MENU</button>
            </div>
        </div>
    </div>

    <!-- MAIN GAME LOGIC SCRIPT -->
    <script>
        // --- GAME STORAGE & STATE ---
        let gameState = 'MENU'; // MENU, GARAGE, LEVELS, PLAYING, PAUSED, GAMEOVER
        let playerSave = JSON.parse(localStorage.getItem('HCA_SAVE')) || {
            coins: 500,
            upgrades: { engine: 1, tires: 1, suspension: 1, turbo: 1 },
            selectedBiome: 0
        };

        function saveGame() {
            localStorage.setItem('HCA_SAVE', JSON.stringify(playerSave));
        }

        // --- AUDIO ENGINE (Web Audio API) ---
        class AudioEngine {
            constructor() {
                this.ctx = null;
                this.engineOsc = null;
                this.engineGain = null;
                this.initialized = false;
            }

            init() {
                if (this.initialized) return;
                try {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();

                    // Engine Hum Oscillator
                    this.engineOsc = this.ctx.createOscillator();
                    this.engineOsc.type = 'sawtooth';
                    this.engineOsc.frequency.setValueAtTime(60, this.ctx.currentTime);

                    this.engineGain = this.ctx.createGain();
                    this.engineGain.gain.setValueAtTime(0, this.ctx.currentTime);

                    this.engineOsc.connect(this.engineGain);
                    this.engineGain.connect(this.ctx.destination);
                    this.engineOsc.start();

                    this.initialized = true;
                } catch(e) {
                    console.warn("Web Audio not supported or blocked", e);
                }
            }

            updateEngineSound(speed, throttle, active) {
                if (!this.initialized || !this.ctx) return;
                if (!active || gameState !== 'PLAYING') {
                    this.engineGain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.1);
                    return;
                }
                const targetFreq = 40 + Math.abs(speed) * 1.5 + (throttle ? 40 : 0);
                const targetGain = 0.05 + Math.min(Math.abs(speed) / 50, 0.1);
                this.engineOsc.frequency.setTargetAtTime(targetFreq, this.ctx.currentTime, 0.05);
                this.engineGain.gain.setTargetAtTime(targetGain, this.ctx.currentTime, 0.05);
            }

            playCoinSound() {
                if (!this.initialized || !this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(987.77, this.ctx.currentTime); // B5
                osc.frequency.setValueAtTime(1318.51, this.ctx.currentTime + 0.08); // E6
                gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.3);
            }

            playNitroSound() {
                if (!this.initialized || !this.ctx) return;
                // White noise burst for nitro
                const bufferSize = this.ctx.sampleRate * 0.5;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(800, this.ctx.currentTime);
                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.5);
                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start();
            }
        }

        const audioEngine = new AudioEngine();

        // --- CANVAS & GRAPHICS SETUP ---
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // --- PROCEDURAL TERRAIN GENERATOR ---
        class TerrainGenerator {
            constructor(biomeIndex) {
                this.biomeIndex = biomeIndex;
                this.points = [];
                this.coins = [];
                this.segmentWidth = 30;
                this.generateInitialTerrain();
            }

            generateInitialTerrain() {
                this.points = [];
                this.coins = [];
                let y = 300;
                let slope = 0;
                for (let x = -200; x < 15000; x += this.segmentWidth) {
                    if (x > 0) {
                        slope += (Math.random() - 0.48) * 0.35;
                        slope = Math.max(-0.7, Math.min(0.7, slope));
                        y += slope * this.segmentWidth;
                        // Keep within reasonable screen bounds
                        if (y < 100) { y = 100; slope = 0.2; }
                        if (y > 700) { y = 700; slope = -0.2; }
                    }
                    this.points.push({ x: x, y: y, friction: this.getBiomeFriction() });

                    // Spawn Coins
                    if (x > 300 && Math.random() < 0.25) {
                        this.coins.push({ x: x, y: y - 50, collected: false, radius: 12 });
                    }
                }
            }

            getBiomeFriction() {
                switch(this.biomeIndex) {
                    case 1: return 0.6; // Icy caverns
                    case 2: return 1.1; // Volcanic high grip
                    case 3: return 0.9;
                    default: return 1.0; // Cybercity
                }
            }

            getHeight(x) {
                // Find surrounding points and interpolate
                let index = Math.floor((x + 200) / this.segmentWidth);
                if (index < 0) index = 0;
                if (index >= this.points.length - 1) index = this.points.length - 2;
                
                const p1 = this.points[index];
                const p2 = this.points[index + 1];
                if (!p1 || !p2) return 400;

                const t = (x - p1.x) / (p2.x - p1.x);
                return p1.y + t * (p2.y - p1.y);
            }

            getSlope(x) {
                let h1 = this.getHeight(x - 5);
                let h2 = this.getHeight(x + 5);
                return Math.atan2(h2 - h1, 10);
            }
        }

        // --- PARTICLE SYSTEM ---
        class ParticleSystem {
            constructor() {
                this.particles = [];
            }

            emit(x, y, vx, vy, color, count = 1) {
                for (let i = 0; i < count; i++) {
                    this.particles.push({
                        x: x, y: y,
                        vx: vx + (Math.random() - 0.5) * 3,
                        vy: vy + (Math.random() - 0.5) * 3,
                        alpha: 1.0,
                        decay: 0.02 + Math.random() * 0.03,
                        color: color,
                        size: 2 + Math.random() * 3
                    });
                }
            }

            update() {
                for (let i = this.particles.length - 1; i >= 0; i--) {
                    let p = this.particles[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.alpha -= p.decay;
                    if (p.alpha <= 0) {
                        this.particles.splice(i, 1);
                    }
                }
            }

            draw(ctx) {
                for (let p of this.particles) {
                    ctx.save();
                    ctx.globalAlpha = p.alpha;
                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }
        }

        // --- VEHICLE PHYSICS ENGINE ---
        class Vehicle {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.vx = 0;
                this.vy = 0;
                this.angle = 0;
                this.vAngle = 0;
                
                // Dimensions
                this.width = 70;
                this.height = 30;
                this.mass = 1200;

                // Wheels
                this.wheelBase = 50;
                this.wheelRadius = 16;
                this.rearWheel = { x: x - 25, y: y + 20, vx: 0, vy: 0, groundContact: false, rotation: 0 };
                this.frontWheel = { x: x + 25, y: y + 20, vx: 0, vy: 0, groundContact: false, rotation: 0 };

                // State
                this.fuel = 100;
                this.maxFuel = 100;
                this.distance = 0;
                this.coinsCollected = 0;
                this.score = 0;
                this.nitroActive = false;
                this.nitroTimer = 0;

                // Flips & Stunts
                this.totalRotation = 0;
                this.lastAngle = 0;
                this.inAir = false;
                this.airTime = 0;
            }

            update(terrain, input) {
                // Get upgrade multipliers
                const engineLevel = playerSave.upgrades.engine;
                const tiresLevel = playerSave.upgrades.tires;
                const suspLevel = playerSave.upgrades.suspension;
                const turboLevel = playerSave.upgrades.turbo;

                const gravity = 0.45;
                this.vy += gravity;

                // Handle Nitro
                if (input.nitro && this.nitroTimer <= 0 && this.fuel > 10) {
                    this.nitroActive = true;
                    this.nitroTimer = 60 + turboLevel * 15;
                    this.fuel -= 15;
                    audioEngine.playNitroSound();
                }
                if (this.nitroTimer > 0) {
                    this.nitroTimer--;
                    if (this.nitroTimer <= 0) this.nitroActive = false;
                }

                // Throttle / Brake
                let power = (0.35 + engineLevel * 0.05) * (this.nitroActive ? 2.2 : 1.0);
                if (input.right && this.fuel > 0) {
                    this.vx += Math.cos(this.angle) * power;
                    this.vy += Math.sin(this.angle) * power;
                    this.fuel -= 0.02;
                    audioEngine.updateEngineSound(this.vx, true, true);
                } else if (input.left) {
                    this.vx -= Math.cos(this.angle) * (power * 0.6);
                    audioEngine.updateEngineSound(this.vx, false, true);
                } else {
                    audioEngine.updateEngineSound(this.vx, false, gameState === 'PLAYING');
                }

                // Air rotation / Driver Lean
                if (input.left) this.vAngle -= 0.008;
                if (input.right) this.vAngle += 0.008;

                // Apply velocity
                this.x += this.vx;
                this.y += this.vy;
                this.angle += this.vAngle;

                // Damping
                this.vx *= 0.99;
                this.vy *= 0.99;
                this.vAngle *= 0.92;

                // Wheel positions relative to chassis
                const cos = Math.cos(this.angle);
                const sin = Math.sin(this.angle);

                // Rear wheel offset
                let rwTargetX = this.x - cos * 25 + sin * 15;
                let rwTargetY = this.y - sin * 25 - cos * 15;
                // Front wheel offset
                let fwTargetX = this.x + cos * 25 + sin * 15;
                let fwTargetY = this.y + sin * 25 - cos * 15;

                // Terrain Collision for Wheels
                let groundHeightR = terrain.getHeight(rwTargetX);
                let groundHeightF = terrain.getHeight(fwTargetX);

                this.rearWheel.groundContact = false;
                this.frontWheel.groundContact = false;

                // Suspension Spring Constants
                const springK = 0.15 + suspLevel * 0.02;

                if (rwTargetY >= groundHeightR - this.wheelRadius) {
                    this.rearWheel.y = groundHeightR - this.wheelRadius;
                    this.rearWheel.x = rwTargetX;
                    this.rearWheel.groundContact = true;
                    // Push chassis up based on suspension
                    let penetration = (rwTargetY - (groundHeightR - this.wheelRadius));
                    this.y -= penetration * springK;
                    this.vy -= penetration * springK * 0.5;
                    this.vx += (input.right ? 0.3 : 0) * (tiresLevel * 0.1);
                    particleSystem.emit(this.rearWheel.x, this.rearWheel.y + this.wheelRadius, (Math.random()-0.5)*2, -2, '#00f3ff', 2);
                }

                if (fwTargetY >= groundHeightF - this.wheelRadius) {
                    this.frontWheel.y = groundHeightF - this.wheelRadius;
                    this.frontWheel.x = fwTargetX;
                    this.frontWheel.groundContact = true;
                    let penetration = (fwTargetY - (groundHeightF - this.wheelRadius));
                    this.y -= penetration * springK;
                    this.vy -= penetration * springK * 0.5;
                    particleSystem.emit(this.frontWheel.x, this.frontWheel.y + this.wheelRadius, (Math.random()-0.5)*2, -2, '#00f3ff', 2);
                }

                // If both wheels on ground, align angle with terrain slope
                if (this.rearWheel.groundContact && this.frontWheel.groundContact) {
                    let slopeAngle = Math.atan2(groundHeightF - groundHeightR, fwTargetX - rwTargetX);
                    this.angle += (slopeAngle - this.angle) * 0.2;
                    this.vAngle *= 0.5;
                    this.inAir = false;
                    this.airTime = 0;
                } else {
                    this.inAir = true;
                    this.airTime++;
                }

                // Track Rotational Flips
                let angleDiff = this.angle - this.lastAngle;
                this.totalRotation += angleDiff;
                this.lastAngle = this.angle;

                if (Math.abs(this.totalRotation) >= Math.PI * 2) {
                    triggerStunt(this.totalRotation > 0 ? "FORWARD FLIP!" : "BACKFLIP!", 500);
                    this.totalRotation = 0;
                }

                // Update Distance
                this.distance = Math.max(this.distance, Math.floor(this.x / 10));

                // Check Game Over Conditions (Rollover or out of fuel/stuck upside down)
                if (this.y > 800 || (this.fuel <= 0 && Math.abs(this.vx) < 0.2)) {
                    triggerGameOver("REACTOR DEPLETED / CHASSIS DESTROYED");
                }
            }

            draw(ctx) {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.angle);

                // Draw Chassis Neon Body
                ctx.fillStyle = '#0f172a';
                ctx.strokeStyle = this.nitroActive ? '#eab308' : '#00f3ff';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.roundRect(-35, -15, 70, 25, 8);
                ctx.fill();
                ctx.stroke();

                // Cockpit Canopy
                ctx.fillStyle = 'rgba(0, 243, 255, 0.3)';
                ctx.beginPath();
                ctx.roundRect(-10, -25, 30, 15, 6);
                ctx.fill();
                ctx.stroke();

                // Roll cage / Neon accent
                ctx.strokeStyle = '#a855f7';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(-25, -15);
                ctx.lineTo(15, -15);
                ctx.stroke();

                ctx.restore();

                // Draw Wheels (Independent World Positions)
                this.drawWheel(ctx, this.x - 25, this.y + 20);
                this.drawWheel(ctx, this.x + 25, this.y + 20);
            }

            drawWheel(ctx, wx, wy) {
                ctx.save();
                ctx.translate(wx, wy);
                ctx.fillStyle = '#1e293b';
                ctx.strokeStyle = '#00f3ff';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(0, 0, this.wheelRadius, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                // Wheel rims
                ctx.strokeStyle = '#a855f7';
                ctx.beginPath();
                ctx.moveTo(-10, 0); ctx.lineTo(10, 0);
                ctx.moveTo(0, -10); ctx.lineTo(0, 10);
                ctx.stroke();
                ctx.restore();
            }
        }

        // --- GAME INSTANCES ---
        let terrain;
        let vehicle;
        let particleSystem;
        let cameraX = 0;
        let cameraY = 0;

        const input = { left: false, right: false, nitro: false };

        // Input Listeners
        window.addEventListener('keydown', (e) => {
            audioEngine.init();
            if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') input.right = true;
            if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') input.left = true;
            if (e.key === ' ') { input.nitro = true; e.preventDefault(); }
            if (e.key === 'Escape') togglePause();
        });

        window.addEventListener('keyup', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') input.right = false;
            if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') input.left = false;
            if (e.key === ' ') input.nitro = false;
        });

        // Touch controls support for mobile
        document.getElementById('nitroBtn').addEventListener('touchstart', () => { audioEngine.init(); input.nitro = true; });
        document.getElementById('nitroBtn').addEventListener('touchend', () => { input.nitro = false; });

        // --- UI NAVIGATION & MENU FUNCTIONS ---
        function startGame() {
            audioEngine.init();
            document.getElementById('mainMenu').classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => document.getElementById('mainMenu').style.display = 'none', 500);
            
            document.getElementById('hudTop').classList.remove('opacity-0');
            document.getElementById('hudBottom').classList.remove('opacity-0');

            terrain = new TerrainGenerator(playerSave.selectedBiome);
            vehicle = new Vehicle(100, 200);
            particleSystem = new ParticleSystem();
            gameState = 'PLAYING';
        }

        function openGarage() {
            updateGarageUI();
            document.getElementById('garageMenu').style.display = 'flex';
        }

        function closeGarage() {
            document.getElementById('garageMenu').style.display = 'none';
        }

        function openGarageFromPause() {
            document.getElementById('pauseMenu').style.display = 'none';
            openGarage();
        }

        function openLevelSelect() {
            document.getElementById('levelMenu').style.display = 'flex';
        }

        function closeLevelSelect() {
            document.getElementById('levelMenu').style.display = 'none';
        }

        function selectBiome(index) {
            playerSave.selectedBiome = index;
            saveGame();
            closeLevelSelect();
        }

        function togglePause() {
            if (gameState === 'PLAYING') {
                gameState = 'PAUSED';
                document.getElementById('pauseMenu').style.display = 'flex';
            } else if (gameState === 'PAUSED') {
                resumeGame();
            }
        }

        function resumeGame() {
            gameState = 'PLAYING';
            document.getElementById('pauseMenu').style.display = 'none';
        }

        function returnToMainMenu() {
            gameState = 'MENU';
            document.getElementById('pauseMenu').style.display = 'none';
            document.getElementById('gameOverMenu').style.display = 'none';
            document.getElementById('mainMenu').style.display = 'flex';
            document.getElementById('mainMenu').classList.remove('opacity-0', 'pointer-events-none');
            document.getElementById('hudTop').classList.add('opacity-0');
            document.getElementById('hudBottom').classList.add('opacity-0');
        }

        function restartGame() {
            document.getElementById('gameOverMenu').style.display = 'none';
            startGame();
        }

        function triggerGameOver(reason) {
            gameState = 'GAMEOVER';
            audioEngine.updateEngineSound(0, false, false);
            document.getElementById('gameOverReason').innerText = reason;
            document.getElementById('endDistance').innerText = vehicle.distance + ' m';
            
            const earnedCoins = Math.floor(vehicle.distance / 5) + vehicle.coinsCollected * 10;
            playerSave.coins += earnedCoins;
            saveGame();

            document.getElementById('endCoins').innerText = '+' + earnedCoins + ' 🪙';
            document.getElementById('gameOverMenu').style.display = 'flex';
        }

        function triggerStunt(text, reward) {
            playerSave.coins += Math.floor(reward / 10);
            saveGame();
            const alertEl = document.getElementById('stuntAlert');
            alertEl.innerText = text;
            alertEl.classList.remove('opacity-0', 'scale-50');
            alertEl.classList.add('opacity-100', 'scale-100');
            setTimeout(() => {
                alertEl.classList.remove('opacity-100', 'scale-100');
                alertEl.classList.add('opacity-0', 'scale-50');
            }, 1200);
        }

        function updateGarageUI() {
            document.getElementById('garageCoins').innerText = playerSave.coins + ' 🪙';
            ['engine', 'tires', 'suspension', 'turbo'].forEach(stat => {
                let lvl = playerSave.upgrades[stat];
                let cost = lvl * 100;
                document.getElementById('lvl' + capitalize(stat)).innerText = lvl;
                document.getElementById('cost' + capitalize(stat)).innerText = cost;
            });
        }

        function upgradeStat(stat) {
            let cost = playerSave.upgrades[stat] * 100;
            if (playerSave.coins >= cost && playerSave.upgrades[stat] < 10) {
                playerSave.coins -= cost;
                playerSave.upgrades[stat]++;
                saveGame();
                updateGarageUI();
            }
        }

        function capitalize(s) {
            return s.charAt(0).toUpperCase() + s.slice(1);
        }

        // --- MAIN GAME LOOP ---
        function gameLoop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (gameState === 'PLAYING') {
                // Update Physics
                vehicle.update(terrain, input);
                particleSystem.update();

                // Check Coin Collisions
                for (let coin of terrain.coins) {
                    if (!coin.collected) {
                        let dist = Math.hypot(vehicle.x - coin.x, vehicle.y - coin.y);
                        if (dist < 35) {
                            coin.collected = true;
                            vehicle.coinsCollected++;
                            audioEngine.playCoinSound();
                            particleSystem.emit(coin.x, coin.y, 0, -3, '#eab308', 8);
                        }
                    }
                }

                // Camera Smoothing
                let targetCamX = vehicle.x - canvas.width * 0.35;
                let targetCamY = vehicle.y - canvas.height * 0.5;
                cameraX += (targetCamX - cameraX) * 0.1;
                cameraY += (targetCamY - cameraY) * 0.1;

                // Update HUD Elements
                document.getElementById('hudDistance').innerText = vehicle.distance + ' m';
                document.getElementById('hudCoins').innerText = vehicle.coinsCollected + ' 🪙';
                document.getElementById('hudSpeed').innerText = Math.abs(Math.floor(vehicle.vx * 3.6)) + ' km/h';
                document.getElementById('fuelBar').style.width = Math.max(0, vehicle.fuel) + '%';
                document.getElementById('fuelText').innerText = Math.max(0, Math.floor(vehicle.fuel)) + '%';
            }

            // --- RENDER WORLD ---
            ctx.save();
            ctx.translate(-cameraX, -cameraY);

            // Draw Background Parallax Grids / Stars
            ctx.strokeStyle = 'rgba(0, 243, 255, 0.05)';
            ctx.lineWidth = 1;
            for (let x = Math.floor(cameraX / 100) * 100; x < cameraX + canvas.width + 100; x += 100) {
                ctx.beginPath(); ctx.moveTo(x, cameraY); ctx.lineTo(x, cameraY + canvas.height); ctx.stroke();
            }

            // Draw Terrain Vector Path
            ctx.fillStyle = '#0a0a16';
            ctx.strokeStyle = playerSave.selectedBiome === 1 ? '#38bdf8' : (playerSave.selectedBiome === 2 ? '#ef4444' : '#00f3ff');
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(terrain.points[0].x, terrain.points[0].y);
            for (let i = 1; i < terrain.points.length; i++) {
                ctx.lineTo(terrain.points[i].x, terrain.points[i].y);
            }
            ctx.lineTo(terrain.points[terrain.points.length - 1].x, cameraY + canvas.height + 500);
            ctx.lineTo(terrain.points[0].x, cameraY + canvas.height + 500);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            // Draw Coins
            for (let coin of terrain.coins) {
                if (!coin.collected && coin.x > cameraX - 100 && coin.x < cameraX + canvas.width + 100) {
                    ctx.save();
                    ctx.fillStyle = '#eab308';
                    ctx.shadowColor = '#eab308';
                    ctx.shadowBlur = 12;
                    ctx.beginPath();
                    ctx.arc(coin.x, coin.y, coin.radius, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            }

            // Draw Particles
            if (particleSystem) {
                particleSystem.draw(ctx);
            }

            // Draw Vehicle
            if (vehicle) {
                vehicle.draw(ctx);
            }

            ctx.restore();

            requestAnimationFrame(gameLoop);
        }

        // Start Loop
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
